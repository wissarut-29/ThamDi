# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit .env
MODEL_BACKEND=fake          # fake | local
MODEL_PATH=models/thamdi
DEMO_MODE=false
JWT_SECRET=change-me
DEMO_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data               # dataset ที่อัปโหลดเก็บที่ DATA_DIR/datasets/ (relative = นับจาก root ของ repo)
ALLOW_REGISTER=true         # เปิดให้เพื่อนสมัครบัญชีเองจากหน้าเว็บ · false = มีแค่ผู้ใช้ demo
MAX_USERS=200
